{
  "schema_version": 2,
  "target": "Qualcomm Iris stateful V4L2 on ARM64 (SM8550, decode-order kernel module)",
  "policy": {
    "production_va_requires_exact_evidence": true,
    "unknown_codec_action": "software-fallback",
    "import_requires_exact_evidence": true,
    "evidence": "TEST-RESULTS.md (Phase 3, 5, 7 sections; Import gate 2026-09-22)"
  },
  "codecs": [
    {
      "codec": "h264",
      "production": "supported",
      "va_profiles": [
        "H264ConstrainedBaseline",
        "H264Main",
        "H264High"
      ],
      "v4l2_output_formats": [
        "H264"
      ],
      "capture_formats": [
        "NV12"
      ],
      "fallback": "software",
      "rejected": [
        "MVC/multiview",
        "interlaced",
        "non-8-bit or non-4:2:0"
      ],
      "publish_import": "qualified",
      "encode": {
        "production": "supported",
        "va_profiles": [
          "H264ConstrainedBaseline",
          "H264Main",
          "H264High"
        ],
        "v4l2_capture_formats": [
          "H264"
        ],
        "raw_formats": [
          "NV12"
        ],
        "rate_control": [
          "CBR",
          "VBR",
          "CQP"
        ],
        "rejected": [
          "B-frames",
          "on-demand IDR",
          "packed headers (Annex-B output only)",
          "deblocking other than the kernel default: no loop-filter controls on SM8550",
          "multi-slice",
          "weighted prediction, scaling lists and chroma QP offsets",
          "more than one reference index",
          "10-bit or non-4:2:0"
        ]
      },
      "experimental": []
    },
    {
      "codec": "hevc",
      "production": "supported",
      "va_profiles": [
        "HEVCMain",
        "HEVCMain10"
      ],
      "v4l2_output_formats": [
        "HEVC"
      ],
      "capture_formats": [
        "NV12",
        "P010"
      ],
      "fallback": "software",
      "rejected": [
        "long-term references (generated parameter sets cannot describe them)",
        "interlaced",
        "12-bit"
      ],
      "publish_import": "qualified",
      "encode": {
        "production": "supported",
        "va_profiles": [
          "HEVCMain"
        ],
        "v4l2_capture_formats": [
          "HEVC"
        ],
        "raw_formats": [
          "NV12"
        ],
        "rate_control": [
          "CBR",
          "VBR",
          "CQP"
        ],
        "rejected": [
          "HEVC Main10",
          "B-frames",
          "on-demand IDR",
          "packed headers (Annex-B output only)",
          "deblocking other than the kernel default: no loop-filter controls on SM8550",
          "multi-slice",
          "tiles and wavefront coding",
          "weighted prediction, scaling lists, chroma QP offsets and CTU bit limits"
        ]
      },
      "experimental": []
    },
    {
      "codec": "vp9",
      "production": "supported",
      "va_profiles": [
        "VP9Profile0",
        "VP9Profile2"
      ],
      "v4l2_output_formats": [
        "VP9"
      ],
      "capture_formats": [
        "NV12",
        "P010"
      ],
      "fallback": "software",
      "rejected": [
        "show_existing_frame through VA",
        "12-bit",
        "RGB"
      ],
      "publish_import": "fallback",
      "import_note": "an alt-ref access unit decodes as two pictures: a one-buffer window stalls ~500 ms per alt-ref, a two-buffer window lets the firmware choose the buffer (153/609 misplaced). Copy until the translator submits one AU per picture",
      "encode": {
        "production": "absent",
        "va_profiles": [],
        "v4l2_capture_formats": [],
        "raw_formats": [],
        "rate_control": [],
        "rejected": [
          "the IRIS encoder node exposes no VP9 capture format"
        ]
      },
      "experimental": []
    },
    {
      "codec": "av1",
      "production": "fallback",
      "va_profiles": [],
      "v4l2_output_formats": [
        "AV1"
      ],
      "capture_formats": [
        "NV12"
      ],
      "fallback": "native-v4l2-or-software",
      "rejected": [
        "hidden (show_frame=0) pictures: the firmware returns no CAPTURE for them and VA has no show_existing_frame call",
        "every stream fails at the first picture: VA AV1 carries no refresh_frame_flags, so the translator holds each picture until its successor arrives, and the firmware returns a CAPTURE only after the next AU is queued",
        "film grain",
        "large-scale tile"
      ],
      "publish_import": "fallback",
      "encode": {
        "production": "absent",
        "va_profiles": [],
        "v4l2_capture_formats": [],
        "raw_formats": [],
        "rate_control": [],
        "rejected": [
          "the IRIS encoder node exposes no AV1 capture format"
        ]
      },
      "experimental": [
        "V4L2_VA_EXPERIMENTAL_PROFILES=1 advertises AV1Profile0; the OBU rebuild is bit-exact under test/av1-obu-roundtrip.sh but VA clients fail at the first picture (see rejected)"
      ]
    }
  ]
}
