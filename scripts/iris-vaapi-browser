#!/bin/sh

# Launch Chromium-family browsers against the Qualcomm Iris decoder without
# depending on a boot-specific /dev/video number or a build-tree driver path.

set -eu

usage() {
    cat <<'EOF'
Usage: iris-vaapi-browser [OPTIONS] [--] [BROWSER_ARGUMENTS...]

Options:
  --browser=auto|chromium|chrome  Select the browser family (default: auto).
  --print-node                   Print the resolved Iris decoder and exit.
  -h, --help                     Show this help.

Google Chrome is the qualified client: stock arm64 Chrome has no video decode
path other than VA-API, and this launcher gives it the Iris driver. Fedora's
Chromium is built with its own native V4L2 decoder and does not use this
driver; --browser=chromium is accepted for a separately built Chromium that
lacks that path. The launcher passes no video-decoder feature override:
Chromium's packaged default is the configuration this project qualifies.
LIBVA_V4L2_VIDEO_PATH may override automatic node discovery; the encoder node
is discovered next to it and exported as LIBVA_V4L2_ENCODER_PATH when
present, so a sandboxed client never has to glob /dev/video*.
IRIS_BROWSER_BIN may override browser executable discovery.
IRIS_BROWSER_PROFILE_ROOT may override the isolated profile root.
EOF
}

fail() {
    echo "iris-vaapi-browser: $*" >&2
    exit 1
}

# The encoder node, if there is one. A display without it still decodes, so
# an absent encoder is not an error: the driver probes it as non-fatal and
# advertises no encode entrypoint. It is resolved and exported anyway because
# the driver falls back to globbing /dev/video* when the variable is unset,
# and a sandboxed process (Firefox's RDD, for one) may be denied that glob.
# Naming both nodes is what keeps a client on this driver without weakening
# the sandbox.
resolve_iris_encoder() {
    if [ -n "${LIBVA_V4L2_ENCODER_PATH:-}" ]; then
        [ -c "$LIBVA_V4L2_ENCODER_PATH" ] \
            || fail "LIBVA_V4L2_ENCODER_PATH is not a character device: $LIBVA_V4L2_ENCODER_PATH"
        printf '%s\n' "$LIBVA_V4L2_ENCODER_PATH"
        return 0
    fi

    command -v v4l2-ctl >/dev/null 2>&1 || return 0

    for candidate in /dev/video*; do
        [ -c "$candidate" ] || continue
        # `|| true`: v4l2-ctl exits non-zero on nodes that are not simple
        # video devices, and this script runs under set -e.
        info=$(v4l2-ctl -d "$candidate" --info 2>/dev/null || true)
        driver=$(printf '%s\n' "$info" \
            | sed -n 's/^[[:space:]]*Driver name[[:space:]]*:[[:space:]]*//p' \
            | sed -n '1p')
        [ "$driver" = iris_driver ] || continue
        card=$(printf '%s\n' "$info" \
            | sed -n 's/^[[:space:]]*Card type[[:space:]]*:[[:space:]]*//p' \
            | sed -n '1p')
        case "$card" in
            *[Ee]ncoder*)
                printf '%s\n' "$candidate"
                return 0
                ;;
        esac
    done
    return 0
}

resolve_iris_decoder() {
    if [ -n "${LIBVA_V4L2_VIDEO_PATH:-}" ]; then
        [ -c "$LIBVA_V4L2_VIDEO_PATH" ] \
            || fail "LIBVA_V4L2_VIDEO_PATH is not a character device: $LIBVA_V4L2_VIDEO_PATH"
        printf '%s\n' "$LIBVA_V4L2_VIDEO_PATH"
        return 0
    fi

    command -v v4l2-ctl >/dev/null 2>&1 \
        || fail 'v4l2-ctl is required to resolve the iris_driver decoder dynamically'

    decoder=''
    fallback=''
    iris_count=0
    for candidate in /dev/video*; do
        [ -c "$candidate" ] || continue
        info=$(v4l2-ctl -d "$candidate" --info 2>/dev/null || true)
        driver=$(printf '%s\n' "$info" \
            | sed -n 's/^[[:space:]]*Driver name[[:space:]]*:[[:space:]]*//p' \
            | sed -n '1p')
        [ "$driver" = iris_driver ] || continue

        iris_count=$((iris_count + 1))
        fallback=$candidate
        card=$(printf '%s\n' "$info" \
            | sed -n 's/^[[:space:]]*Card type[[:space:]]*:[[:space:]]*//p' \
            | sed -n '1p')
        sys_name=$(cat "/sys/class/video4linux/${candidate##*/}/name" 2>/dev/null || true)
        case "$card:$sys_name" in
            *[Dd]ecoder*)
                [ -z "$decoder" ] \
                    || fail "multiple iris_driver decoder nodes found: $decoder and $candidate"
                decoder=$candidate
                ;;
        esac
    done

    if [ -n "$decoder" ]; then
        printf '%s\n' "$decoder"
        return 0
    fi
    if [ "$iris_count" -eq 1 ]; then
        printf '%s\n' "$fallback"
        return 0
    fi
    if [ "$iris_count" -gt 1 ]; then
        fail 'multiple iris_driver nodes found but none identifies itself as the decoder'
    fi
    fail 'no /dev/video* node reports iris_driver; refusing a fixed-node fallback'
}

find_browser() {
    if [ -n "${IRIS_BROWSER_BIN:-}" ]; then
        case "$IRIS_BROWSER_BIN" in
            */*) [ -x "$IRIS_BROWSER_BIN" ] || fail "browser is not executable: $IRIS_BROWSER_BIN" ;;
            *) command -v "$IRIS_BROWSER_BIN" >/dev/null 2>&1 \
                || fail "browser is not on PATH: $IRIS_BROWSER_BIN" ;;
        esac
        command -v "$IRIS_BROWSER_BIN" 2>/dev/null || printf '%s\n' "$IRIS_BROWSER_BIN"
        return 0
    fi

    case "$browser_family" in
        chromium) candidates='chromium chromium-browser' ;;
        chrome) candidates='google-chrome-stable google-chrome' ;;
        auto) candidates='chromium chromium-browser google-chrome-stable google-chrome' ;;
        *) fail "unsupported browser family: $browser_family" ;;
    esac
    for candidate in $candidates; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    fail "no supported $browser_family browser found on PATH"
}

browser_family=auto

print_node=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --browser=auto|--browser=chromium|--browser=chrome)
            browser_family=${1#--browser=}
            shift
            ;;
        --print-node)
            print_node=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

node=$(resolve_iris_decoder)
encoder_node=$(resolve_iris_encoder || true)
if [ "$print_node" -eq 1 ]; then
    printf '%s\n' "$node"
    exit 0
fi

browser=$(find_browser)
case "${browser##*/}" in
    chromium|chromium-browser*) profile_browser=chromium ;;
    google-chrome*) profile_browser=google-chrome ;;
    *)
        case "$browser_family" in
            chrome) profile_browser=google-chrome ;;
            *) profile_browser=chromium ;;
        esac
        ;;
esac

profile_root=${IRIS_BROWSER_PROFILE_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/iris-vaapi-browser}
profile_dir=$profile_root/$profile_browser-vaapi
mkdir -p "$profile_dir"

# Fedora's Chromium 152 arm64 package injects AcceleratedVideoDecodeLinuxGL
# and AcceleratedVideoDecodeLinuxZeroCopyGL from /etc/chromium/chromium.conf.
# On the qualified SM8550 kernel that combination can take the Adreno GPU
# through a GMU vote timeout and GPU fault before media playback recovers.
# Keep that unqualified Fedora native path on explicit software fallback.
# Google Chrome uses the separate VA-API path and is unchanged.
# Scope this to the Fedora build fingerprint, not every Chromium >= 152:
# the separately built upstream 154 binary can use our VA-API backend, and
# disabling its GL selectors silently changes it to software decoding.
browser_version=$($browser --version 2>/dev/null || true)
browser_major=$(printf '%s\n' "$browser_version" \
    | sed -n 's/.* \([0-9][0-9]*\)\..*/\1/p' | head -1)
chromium_compat_args=''
case "$profile_browser:$browser_major" in
    chromium:) ;;
    chromium:*[!0-9]*) ;;
    chromium:*)
        if [ "$browser_major" -ge 152 ]; then
            case "$browser_version" in
                *'Built from source for Fedora '*)
                    chromium_compat_args='--enable-features=AcceleratedVideoDecoder --disable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL'
                    echo 'iris-vaapi-browser: unqualified Fedora Chromium native path; using software fallback. Use --browser=chrome for the validated Iris VA-API path.' >&2
                    ;;
            esac
        fi
        ;;
esac

# The installed driver must be discoverable from libva's standard driver
# directory. Do not let a stale build-tree override leak into desktop starts.
unset LIBVA_DRIVERS_PATH
LIBVA_DRIVER_NAME=v4l2
LIBVA_V4L2_VIDEO_PATH=$node
export LIBVA_DRIVER_NAME LIBVA_V4L2_VIDEO_PATH
# Both nodes names are set when the encoder exists, so the driver opens exact
# paths instead of globbing /dev/video*. A sandboxed client that is denied the
# glob then still reaches the driver. Empty means "no encoder node"; the
# driver's own probe for one is non-fatal.
if [ -n "$encoder_node" ]; then
    LIBVA_V4L2_ENCODER_PATH=$encoder_node
    export LIBVA_V4L2_ENCODER_PATH
else
    unset LIBVA_V4L2_ENCODER_PATH
fi

common_args="--ozone-platform=wayland"

# The VA-only default passes no video-decoder feature override at all.
#
# It used to force --disable-features=AcceleratedVideoDecodeLinuxZeroCopyGL.
# On Chrome 151.0.7922.173 that switch is what breaks hardware decode: the
# pipeline constructs VaapiVideoDecoder, reaches
# PickDecoderOutputFormat(): Initializing ImageProcessor, destroys the decoder
# and falls back to FFmpegVideoDecoder. Measured on the qualified target with
# one 1920x1080 H.264 clip and five launch configurations: the packaged
# default, --enable-features=AcceleratedVideoDecodeLinuxGL and
# --enable-features=AcceleratedVideoDecodeLinuxZeroCopyGL each reached
# VaapiVideoDecoder with kIsPlatformVideoDecoder=true, while disabling either
# feature fell back to software.
#
# Leave the selection alone. Chromium's packaged default is the configuration
# this project qualifies, and overriding it here is how the desktop entries
# silently shipped software decode.
exec "$browser" \
    "$common_args" \
    "--user-data-dir=$profile_dir" \
    $chromium_compat_args \
    "$@"
